# 이 파일을 .env.local 로 복사한 뒤 값을 직접 채운다. .env.local 은 공유·커밋하지 않는다.
# 키를 채팅에 붙이지 않는다.

ANTHROPIC_API_KEY=
# Claude 모델 기본값은 claude-opus-5-5. 바꿀 때만 적는다.
# JARVIS_CLAUDE_MODEL=

OPENAI_API_KEY=
# OpenAI는 모델 이름을 꼭 적는다 (Chat Completions에서 쓸 수 있는 모델).
JARVIS_OPENAI_MODEL=

# Grok을 쓸 때만
