# 이 파일을 .env.local 로 복사한 뒤 값을 직접 채운다. .env.local 은 공유·커밋하지 않는다.
# 키를 채팅에 붙이지 않는다.

ANTHROPIC_API_KEY=
# Claude 모델 기본값은 claude-opus-5-5. 바꿀 때만 적는다.
# JARVIS_CLAUDE_MODEL=

OPENAI_API_KEY=
# OpenAI는 모델 이름을 꼭 적는다 (Chat Completions에서 쓸 수 있는 모델).
JARVIS_OPENAI_MODEL=

# Grok을 쓸 때만
# XAI_API_KEY=
# JARVIS_GROK_MODEL=

# 구글 캘린더·Tasks를 쓸 때만(설정 → 단축키·구글의 "연결 준비 방법" 참고).
# Google Cloud 콘솔에서 만든 OAuth 클라이언트(데스크톱 앱)의 값. 로그인은 화면에서 직접 한다.
# JARVIS_GOOGLE_CLIENT_ID=
# JARVIS_GOOGLE_CLIENT_SECRET=
